# このファイルに実際の秘密情報を書かない。`pnpm env:init` で .env をランダム値付きで生成する。
# --- Postgres / Keycloak (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# ホスト側ポート。5432が使用中なら変更する(env:init は POSTGRES_PORT 環境変数を尊重)
POSTGRES_PORT=5432
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
# realm.json のテストユーザー(alice / bob)共通パスワード
TEST_USER_PASSWORD=

# --- アプリ ---
# 形式: postgres://<user>:<password>@localhost:<port>/app
DATABASE_URL=

# --- OIDC (標準OIDCのみ。Cognito等へ差し替え可能) ---
OIDC_ISSUER=http://localhost:8080/realms/tatsujin
OIDC_CLIENT_ID=app-bff
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/

# --- BFF ---
PORT=3000
APP_ORIGIN=http://localhost:5173
# AES-256-GCM鍵: 32バイトのhex(64文字)
COOKIE_SECRET=
NODE_ENV=development
